APP_NAME=BimbelKu
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
FEATURE_TEACHER_REPLACEMENT=true
FRONTEND_URL=http://127.0.0.1:8080
FRONTEND_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
CORS_MAX_AGE=600
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback

# Semua uang masuk memakai hosted checkout Xendit. Isi dengan key TEST lebih
# dahulu; jangan pernah menaruh secret key pada Vite/frontend.
XENDIT_ENABLED=false
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
XENDIT_BASE_URL=https://api.xendit.co
XENDIT_COUNTRY=ID
XENDIT_CURRENCY=IDR
XENDIT_SUCCESS_URL=http://127.0.0.1:8080/payment?gateway=success
XENDIT_CANCEL_URL=http://127.0.0.1:8080/payment?gateway=cancelled
XENDIT_SESSION_TTL_MINUTES=60
# Dibutuhkan untuk payout tutor. Secret key harus memiliki izin MONEY-OUT.
XENDIT_PAYOUT_API_VERSION=2025-09-01
APP_TIMEZONE=Asia/Jakarta
POLICY_VERSION=2026-07-29
PRIMARY_ADMIN_EMAIL=admin@bimbelku.com
SEED_ADMIN_EMAIL=admin@bimbelku.com
SEED_ADMIN_PASSWORD=
SEED_DEMO_USERS=false

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bimbelku
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
# Brevo SMTP: ubah MAIL_MAILER=smtp lalu isi SMTP login dan SMTP key.
MAIL_SCHEME=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@bimbelku.local"
MAIL_FROM_NAME="${APP_NAME}"

# Masa aktif token API dalam menit (12 jam).
# Leave the global Sanctum expiration unset: each login token has its own finite lifetime.
# A global 720-minute cap would also shorten "remember this device" sessions.

# Sesi browser: admin 12 jam; murid/tutor dapat mengingat perangkat 30 hari.
AUTH_SESSION_COOKIE=bimbelku_session
AUTH_SESSION_STANDARD_MINUTES=720
AUTH_SESSION_REMEMBERED_MINUTES=43200
AUTH_SESSION_ADMIN_MINUTES=720
AUTH_SESSION_REFRESH_THRESHOLD_MINUTES=10080
